# Boot into the recovery shell after the config file is corrupted, repair
# the configuration from the rescue shell, and continue to a clean boot.

expect login: timeout=90
send root
expect Password:
send godel
expect godel#

comment corrupt the boot configuration and reboot into it
send echo this-is-not-a-valid-config > /etc/godel/services.conf; sync
expect godel# timeout=10
send godelctl reboot
expect Godel: shutting down timeout=30

comment Godel must enter the recovery shell instead of a boot loop
expect entering recovery timeout=90
send echo rescue-check-$(echo ok)
expect rescue-check-ok timeout=15

comment a repaired configuration takes effect when the shell exits
send printf '%s\n' '[service "beacon"]' 'command = /bin/sh -c "while :; do echo beacon: alive; sleep 30; done"' 'restart = on-failure' '[service "ttyS0"]' 'command = /bin/getty -L 115200 ttyS0 vt100' 'restart = always' 'restart_delay = 1s' > /etc/godel/services.conf
send exit
comment the repaired configuration serves both the beacon and a login prompt
expect login: timeout=90
verify godel: started beacon
verify beacon: alive

comment the repaired configuration must also serve a fresh login prompt
send root
expect Password:
send godel
expect godel#
send godelctl status
expect beacon timeout=10
expect godel# timeout=10

comment graceful poweroff
send godelctl poweroff
expect Godel: shutting down timeout=30
expect powering off timeout=30
