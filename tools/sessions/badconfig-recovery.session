expect login: timeout=90
send root
expect Password:
send godel
expect godel#

comment corrupt the boot configuration and reboot into it
send echo this-is-not-a-valid-config > /etc/godel/services.conf; sync
expect godel# timeout=10
send godelctl reboot
expect Godel: shutting down timeout=30

comment Godel must enter the recovery shell instead of a boot loop
expect entering recovery timeout=90
send echo rescue-check-$(echo ok)
expect rescue-check-ok timeout=15

comment a repaired configuration takes effect when the shell exits
send mount -o remount,rw /
expect / # timeout=10
send printf '%s\n' '[service "rootfs-rw"]' 'command = /bin/mount -o remount,rw /' 'type = oneshot' 'restart = never' '[service "beacon"]' 'command = /bin/sh -c "while :; do echo beacon: alive; sleep 30; done"' 'restart = on-failure' '[service "ttyS0"]' 'command = /bin/getty -L 115200 ttyS0 vt100' 'after = rootfs-rw' 'restart = always' 'restart_delay = 1s' > /etc/godel/services.conf
send exit
comment the repaired configuration serves the beacon and a login prompt
expect login: timeout=90
sleep 1
send root
expect Password:
send godel
expect godel#
verify godel: started beacon
send cat /var/log/godel/beacon.log /run/godel/logs/beacon.log 2>/dev/null
expect beacon: alive timeout=10

comment the repaired configuration is live in the status snapshot
send godelctl status
expect beacon timeout=10
expect godel# timeout=10

comment graceful poweroff
send godelctl poweroff
expect Godel: shutting down timeout=30
expect powering off timeout=30
