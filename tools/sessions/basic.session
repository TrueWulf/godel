expect login: timeout=90
send root
expect Password:
send godel
expect godel#

comment the status snapshot lists every configured service
send godelctl status
expect beacon timeout=10
expect godel# timeout=10

comment the beacon heartbeats into its per-service log, not the console
send cat /run/godel/logs/beacon.log
expect beacon: alive timeout=10
expect godel# timeout=10

comment find the beacon pid from the status snapshot and SIGKILL it
send beacon_pid=$(awk '$1=="beacon"{print $3}' /run/godel/status | cut -d= -f2); echo beacon-pid-is-$beacon_pid
expect beacon-pid-is- timeout=10
expect godel# timeout=10
send kill -9 $beacon_pid
expect godel# timeout=10

comment supervision must log the kill, schedule the restart, and run it
expect killed by signal 9 timeout=15
expect restarting in timeout=15

comment the restarted beacon now logs through the writable root
sleep 2
send cat /var/log/godel/beacon.log
expect beacon: alive timeout=10
expect godel# timeout=10

comment restart counter must be visible in the status snapshot
send godelctl status
expect restarts=1 timeout=10
expect godel# timeout=10

comment graceful poweroff over the godelctl interface
send godelctl poweroff
expect Godel: shutting down timeout=30
expect powering off timeout=30
