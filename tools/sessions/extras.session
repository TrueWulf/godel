# With the optional disks attached, the mount-home and mount-var oneshots
# must actually mount /dev/vdb and /dev/vdc.

expect login: timeout=90
send root
expect Password:
send godel
expect godel#

send echo home-mountpoint-$(mountpoint -q /home && echo yes || echo no)
expect home-mountpoint-yes timeout=15
send cat /home/marker.txt
expect godel home extra disk timeout=10

send echo var-mountpoint-$(mountpoint -q /var && echo yes || echo no)
expect var-mountpoint-yes timeout=15
send cat /var/marker.txt
expect godel var extra disk timeout=10

send godelctl poweroff
expect Godel: shutting down timeout=30
expect powering off timeout=30
